{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/api/**/*.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/data/**/*.ts",
    "src/types/**/*.ts"
  ]
}
